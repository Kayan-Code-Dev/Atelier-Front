APP_NAME=Atelier
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atelier_central
DB_USERNAME=root
DB_PASSWORD=

TENANT_DB_DATABASE=atelier_tenant_template

PLATFORM_ADMIN_NAME="Atelier Admin"
PLATFORM_ADMIN_EMAIL=admin@atelier.local
PLATFORM_ADMIN_PASSWORD=change_me_please

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USERNAME=info@dressnmore.it.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@dressnmore.it.com"
MAIL_FROM_NAME="Atelier"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=http://127.0.0.1:8001/api

# Atelier frontend (port 5176 so it can run beside DressnMore on 5175)
FRONTEND_URL=http://127.0.0.1:5176
SANCTUM_STATEFUL_DOMAINS=localhost:5176,127.0.0.1:5176

# Google Identity Services (Sign in with Google) — Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
SESSION_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:5176,http://127.0.0.1:5176

# Smart Assistant (المساعد الذكي) — WhatsApp Cloud API
SMART_ASSISTANT_WEBHOOK_VERIFY_TOKEN=dressnmore-sa
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_REQUIRE_SIGNATURE=false
META_WHATSAPP_GRAPH_VERSION=v21.0
META_WHATSAPP_API_BASE=https://graph.facebook.com
META_WHATSAPP_TIMEOUT=20
META_WHATSAPP_EMBEDDED_ENABLED=true
META_WHATSAPP_APP_ID=1057619943621467
META_WHATSAPP_CONFIG_ID=1405928088119674
META_WHATSAPP_FEATURE_TYPE=whatsapp_business_app_onboarding
META_WHATSAPP_EMBEDDED_REDIRECT_URI=https://api.dressnmore.it.com/api/smart-assistant/whatsapp/embedded-signup/callback
META_WHATSAPP_FRONTEND_RETURN_URL=https://dressnmore.it.com/smart-assistant
# Optional full onboard URL override (regenerate in Meta with the redirect URI above)
# META_WHATSAPP_ONBOARD_URL=
SMART_ASSISTANT_WA_AUTO_REPLY_MODE=template
# SMART_ASSISTANT_WA_AUTO_REPLY_TEMPLATE="مرحباً..."
SMART_ASSISTANT_WHATSAPP=true
SMART_ASSISTANT_FACEBOOK=true
SMART_ASSISTANT_INSTAGRAM=true
