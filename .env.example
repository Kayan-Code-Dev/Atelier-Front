# Atelier local frontend
# Independent from DressnMore SaaS hosts. Point this at the Atelier backend.

VITE_BACKEND_URL=http://127.0.0.1:8001

# WebSocket / Reverb (Laravel Echo) — local Atelier backend
VITE_REVERB_APP_KEY=your_reverb_app_key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8001
VITE_REVERB_SCHEME=http
VITE_REVERB_AUTH_ENDPOINT=http://127.0.0.1:8001/broadcasting/custom-auth

# Optional: disable WebSocket
# VITE_ENABLE_WEBSOCKET=false
