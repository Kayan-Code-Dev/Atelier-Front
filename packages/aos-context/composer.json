{
  "name": "dressnmore/aos-context",
  "description": "DressnMore AOS — Identity & Context Engine (Sprint 3)",
  "type": "library",
  "version": "0.3.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\Aos\\Context\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DressnMore\\Aos\\Context\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DressnMore\\Aos\\Context\\AosContextServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
