  "type": "library",
  "version": "0.20.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0",
    "dressnmore/aos-planner": "^0.18.0",
