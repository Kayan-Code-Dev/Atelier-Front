{
  "name": "dressnmore/aos-prompts",
  "description": "DressnMore AOS — Prompt Engine (Sprint 7)",
  "type": "library",
  "version": "0.7.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\Aos\\Prompts\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DressnMore\\Aos\\Prompts\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DressnMore\\Aos\\Prompts\\AosPromptsServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
