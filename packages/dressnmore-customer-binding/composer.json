{
  "name": "dressnmore/customer-binding",
  "description": "DressnMore — Customer Domain Binding to AOS Business Tools (Sprint 14)",
  "type": "library",
  "version": "0.14.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0",
    "dressnmore/aos-tools": "^0.4.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\CustomerBinding\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DressnMore\\CustomerBinding\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DressnMore\\CustomerBinding\\CustomerBindingServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
