{
  "name": "dressnmore/aos-workflow",
  "description": "DressnMore AOS - Workflow & Automation Engine (Sprint 12)",
  "type": "library",
  "version": "0.12.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\Aos\\Workflow\\": "src/"
    }
