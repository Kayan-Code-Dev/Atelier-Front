{
  "name": "dressnmore/smart-assistant",
  "description": "DressnMore Smart Assistant — Architecture Foundation (Sprint 21, Frozen v1.0.0)",
  "type": "library",
  "version": "1.0.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0"
  },
  "autoload": {
