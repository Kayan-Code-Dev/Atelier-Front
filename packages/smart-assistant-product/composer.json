{
  "name": "dressnmore/smart-assistant-product",
  "description": "DressnMore Smart Assistant product module — social channels (WhatsApp, Facebook, Instagram)",
  "type": "library",
  "version": "0.25.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "illuminate/routing": ">=11.0",
    "illuminate/http": ">=11.0",
    "illuminate/database": ">=11.0",
    "illuminate/encryption": ">=11.0",
    "illuminate/queue": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/smart-assistant": "^1.0.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\SmartAssistantProduct\\": "src/",
      "DressnMore\\SmartAssistantProduct\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DressnMore\\SmartAssistantProduct\\SmartAssistantProductServiceProvider"
