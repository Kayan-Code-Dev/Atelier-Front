{
  "name": "dressnmore/aos-communication",
  "description": "DressnMore AOS - Omni-Channel Communication Hub (Sprint 11)",
  "type": "library",
  "version": "0.11.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\Aos\\Communication\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DressnMore\\Aos\\Communication\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DressnMore\\Aos\\Communication\\AosCommunicationServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
