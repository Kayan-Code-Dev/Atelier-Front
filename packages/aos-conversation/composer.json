{
  "name": "dressnmore/aos-conversation",
  "description": "DressnMore AOS — Conversation Engine (Sprint 2)",
  "type": "library",
  "version": "0.2.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0"
