{
  "name": "dressnmore/aos-observability",
  "description": "DressnMore AOS — logging, audit, metrics, tracing, and health reporting contracts",
  "type": "library",
  "version": "0.1.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "psr/log": "^3.0",
    "dressnmore/aos-core": "^0.1.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\Aos\\Observability\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DressnMore\\Aos\\Observability\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DressnMore\\Aos\\Observability\\AosObservabilityServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
