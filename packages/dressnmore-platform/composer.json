{
  "name": "dressnmore/platform",
  "description": "DressnMore Platform — AI Assistant product integration (Sprint 18A)",
  "type": "library",
  "version": "0.18.5",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "illuminate/routing": ">=11.0",
    "illuminate/http": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-tenant-ai": "^0.17.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\Platform\\": "src/",
      "DressnMore\\Platform\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DressnMore\\Platform\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DressnMore\\Platform\\DressnMorePlatformServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
