{
  "name": "dressnmore/aos-memory",
  "description": "DressnMore AOS — Memory Engine (Sprint 8)",
  "type": "library",
  "version": "0.8.0",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "illuminate/support": ">=11.0",
    "dressnmore/aos-core": "^0.1.0",
    "dressnmore/aos-events": "^0.1.0"
  },
  "autoload": {
    "psr-4": {
      "DressnMore\\Aos\\Memory\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DressnMore\\Aos\\Memory\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DressnMore\\Aos\\Memory\\AosMemoryServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
